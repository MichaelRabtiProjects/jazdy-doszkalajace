# Skopiuj ten plik jako ".env" i uzupełnij wartości.
# ".env" jest w .gitignore — nigdy nie trafia do repozytorium (to plik z sekretami).

# Wygenerowane przez: node scripts/set-admin-password.mjs
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

PORT=3000
NODE_ENV=development

# 'mock' (atrapa, do testów) albo 'autopay' (prawdziwa bramka - dopiero po
# uzupełnieniu AUTOPAY_SERVICE_ID/AUTOPAY_SHARED_KEY poniżej i przetestowaniu
# w środowisku sandbox, patrz README).
PAYMENT_PROVIDER=mock

# Dane z panelu Autopay (panel.autopay.pl, zakładka "Sklepy" / "Shops") -
# potrzebne tylko jeśli PAYMENT_PROVIDER=autopay.
AUTOPAY_SERVICE_ID=
AUTOPAY_SHARED_KEY=
# 'production' dopiero po realnym przetestowaniu - domyślnie zostajemy w
# środowisku testowym (testpay.autopay.eu), nawet jeśli ta linia jest pusta.
AUTOPAY_ENV=test

# Wysyłka e-maili przez Twoje konto Gmail (SMTP + hasło aplikacji, NIE
# zwykłe hasło do konta). Instrukcja wygenerowania w README.
EMAIL_PROVIDER=gmail
GMAIL_USER=twoj.adres@gmail.com
GMAIL_APP_PASSWORD=
