// Konfiguracja Workera z przypomnieniami (NIE strony — strona ma ustawienia
// w panelu Cloudflare Pages). Wdrożenie: npx wrangler deploy (z tego folderu).
// Klucz Brevo ustawia się osobno: npx wrangler secret put BREVO_API_KEY
//
// Wersja testowa (baza testowa, adres testowy, SMS tylko na numer instruktora):
//   npx wrangler deploy --env test
//   npx wrangler secret put BREVO_API_KEY --env test
{
  "name": "jazdy-przypomnienia",
  "main": "index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "triggers": {
    // co 10 minut — lib/przypomnienia.js sam decyduje, czy coś jest należne
    "crons": ["*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jazdy-doszkalajace-db",
      "database_id": "d5d35a98-acb7-419e-829e-cc8b66f3730b"
    }
  ],
  "vars": {
    "ADRES_STRONY": "https://lajtelka.pl",
    // "tak" = wysyłaj też SMS (płatne kredyty w Brevo); inaczej tylko e-mail
    "SMS_WLACZONE": "nie",
    // bezpiecznik kosztów: najwyżej tyle SMS-ów dziennie
    "SMS_LIMIT_DZIENNY": "40"
  },
  "env": {
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jazdy-doszkalajace-db-test",
          "database_id": "a43aa343-2c8a-4ec7-bf84-f9068abb364e"
        }
      ],
      "vars": {
        "ADRES_STRONY": "https://test.jazdy-doszkalajace.pages.dev",
        "SMS_WLACZONE": "nie",
        // na teście SMS-y wyłącznie na numer instruktora
        "SMS_TYLKO_NUMERY": "48690360164",
        "SMS_LIMIT_DZIENNY": "10"
      }
    }
  }
}
